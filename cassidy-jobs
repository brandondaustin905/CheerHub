    background:var(--cream);box-shadow:inset 0 0 0 2px var(--brass)}
  .tag .num{font-family:'Fraunces',serif;font-weight:700;font-size:19px;margin-top:9px;color:var(--brass-soft)}
  .tag .of{font-family:'IBM Plex Mono',monospace;font-size:8.5px;letter-spacing:.08em;opacity:.75}

  .prepbox li{display:flex;gap:10px;align-items:flex-start;padding:9px 0;border-top:1px solid rgba(229,200,120,.22);font-size:14.5px}
  .prepbox li input{margin-top:4px;accent-color:var(--brass);width:16px;height:16px;flex-shrink:0}
  .prepbox li b{color:var(--brass-soft)}

  footer{max-width:880px;margin:36px auto 44px;padding:0 20px;font-size:12.5px;color:var(--ink-soft);text-align:center}
  .empty{display:none;text-align:center;padding:50px 20px;color:var(--ink-soft)}
  .empty.show{display:block}
  .empty .big{font-family:'Fraunces',serif;font-size:22px;color:var(--ink);margin-bottom:6px}

  @media(max-width:560px){
    .cardtop{grid-template-columns:52px 1fr auto;gap:10px}
    .tag{width:40px;height:52px}
    .tag .num{font-size:16px}
    .paygrid{grid-template-columns:1fr}
  }
  @media(prefers-reduced-motion:reduce){
    *{transition:none!important}
    html{scroll-behavior:auto}
  }
</style>
</head>

  .cmain h2{font-family:'Fraunces',serif;font-weight:600;font-size:17.5px;line-height:1.25;color:var(--ink)}
  .cmain .co{font-size:13.5px;color:var(--ink-soft);margin-top:2px}
  .cmain .row2{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
  .pill{font-family:'IBM Plex Mono',monospace;font-size:10.5px;padding:3px 8px;border-radius:3px;letter-spacing:.03em}

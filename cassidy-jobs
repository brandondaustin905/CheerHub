  .heart.saved{color:#B23A48}
  .heart:focus-visible{outline:2px solid var(--brass);outline-offset:2px;border-radius:4px}
  .topright{display:flex;align-items:center;gap:2px}

  /* details */
  .details{display:none;border-top:1.5px dashed var(--line);padding:18px 18px 20px}
  .card.open .details{display:block}
  .details h3{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;

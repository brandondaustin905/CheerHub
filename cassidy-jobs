  .details h3:first-child{margin-top:0}
  .details p{font-size:14.5px;color:var(--ink)}
  .details ul{list-style:none;font-size:14.5px}
  .details ul li{padding-left:18px;position:relative;margin-bottom:6px}
  .details ul li::before{content:"—";position:absolute;left:0;color:var(--brass)}
  .whybox{background:#F3F6F2;border-left:3px solid var(--good);padding:12px 14px;border-radius:0 6px 6px 0;font-size:14.5px}
  .watchbox{background:#FBF4E8;border-left:3px solid var(--warn);padding:12px 14px;border-radius:0 6px 6px 0;font-size:14.5px}
  .paygrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:4px}
  .paycell{border:1.5px solid var(--line);border-radius:6px;padding:10px 12px}

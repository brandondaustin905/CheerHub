const state = {filter:"all", search:"", sort:"fit", saved:new Set()};

function applyUrl(q){return "https://ca.indeed.com/jobs?q=" + encodeURIComponent(q);}
function zipUrl(q){return "https://www.ziprecruiter.com/candidate/search?search=" + encodeURIComponent(q) + "&location=Ontario%2C+Canada";}
function liUrl(q){return "https://www.linkedin.com/jobs/search/?keywords=" + encodeURIComponent(q) + "&location=Canada&f_WT=2";}
function gdUrl(q){return "https://www.glassdoor.ca/Search/results.htm?keyword=" + encodeURIComponent(q);}

function likeRank(l){ if(l.startsWith("High")) return 0; if(l.startsWith("Medium-High")) return 1; if(l.startsWith("Medium")) return 2; return 3; }

function render(){
  const list = document.getElementById("list");
  const q = state.search.toLowerCase();
  let jobs = JOBS.filter(j=>{
    if(state.filter==="80k" && j.tier!=="80k") return false;
    if(["hospitality","service","sales","account"].includes(state.filter) && j.cat!==state.filter) return false;
    if(state.filter==="saved" && !state.saved.has(j.id)) return false;
    if(q && !(j.title+" "+j.co+" "+j.why+" "+j.pay).toLowerCase().includes(q)) return false;
    return true;
  });
  if(state.sort==="fit") jobs.sort((a,b)=>b.fit-a.fit);
  if(state.sort==="pay") jobs.sort((a,b)=>b.payMax-a.payMax);
  if(state.sort==="ease") jobs.sort((a,b)=>a.ease-b.ease || b.fit-a.fit);

  document.getElementById("count").textContent = jobs.length + " of " + JOBS.length + " listings";
  document.getElementById("empty").classList.toggle("show", jobs.length===0);

  list.innerHTML = jobs.map(j=>`
    <article class="card" data-fit="${j.fit<=5?'stretch':'good'}" id="job${j.id}">
      <button class="cardtop" aria-expanded="false" onclick="toggle(${j.id})">
        <span class="tag" aria-label="Fit score ${j.fit} out of 10"><span class="num">${j.fit}</span><span class="of">/10 FIT</span></span>
        <span class="cmain">
          <h2>${j.title}</h2>
          <span class="co">${j.co}</span>
          <span class="row2">
            <span class="pill pay">${j.pay}</span>
            <span class="pill remote">${j.remote}</span>
            <span class="pill like">Odds: ${j.like}</span>
          </span>
        </span>
        <span class="topright">
          <span class="heart ${state.saved.has(j.id)?'saved':''}" role="button" tabindex="0" aria-label="Save to shortlist"
            onclick="event.stopPropagation();saveJob(${j.id})"
            onkeydown="if(event.key==='Enter'){event.stopPropagation();saveJob(${j.id})}">&#9829;</span>
          <span class="caret">&#9662;</span>
        </span>
      </button>
      <div class="details">
        <h3>The role</h3>
        <ul>${j.role.map(r=>`<li>${r}</li>`).join("")}</ul>
        <h3>Why you'd win it</h3>
        <div class="whybox">${j.why}</div>
        <h3>Watch-outs</h3>
        <div class="watchbox">${j.watch}</div>
        <h3>Pay</h3>
        <div class="paygrid">
          <div class="paycell"><b>Advertised</b><span>${j.pay}</span></div>
          <div class="paycell"><b>Structure</b><span>${j.structure}</span></div>
        </div>
        <h3>Apply &amp; research</h3>
        <div class="links">
          <a class="btn primary" target="_blank" rel="noopener" href="${applyUrl(j.search)}">Open on Indeed &rarr;</a>
          <a class="btn ghost" target="_blank" rel="noopener" href="${zipUrl(j.search)}">ZipRecruiter</a>
          <a class="btn ghost" target="_blank" rel="noopener" href="${liUrl(j.search)}">LinkedIn (remote)</a>
          <a class="btn ghost" target="_blank" rel="noopener" href="${gdUrl(j.reviews)}">Reviews &amp; salaries</a>
        </div>
        <p class="linknote">Buttons open a live search for this exact role, so you always land on current postings. Applications go through the job board or the company's careers page — contact emails appear on the posting itself.</p>
      </div>
    </article>`).join("");
}

function toggle(id){
  const card = document.getElementById("job"+id);
  const wasOpen = card.classList.contains("open");
  card.classList.toggle("open");
  card.querySelector(".cardtop").setAttribute("aria-expanded", String(!wasOpen));
}

function saveJob(id){
  if(state.saved.has(id)) state.saved.delete(id); else state.saved.add(id);
  render();
}

document.getElementById("chips").addEventListener("click", e=>{
  const chip = e.target.closest(".chip"); if(!chip) return;
  document.querySelectorAll(".chip").forEach(c=>c.classList.remove("active"));
  chip.classList.add("active");
  state.filter = chip.dataset.filter;
  render();
});
document.getElementById("search").addEventListener("input", e=>{state.search=e.target.value;render();});
document.getElementById("sort").addEventListener("change", e=>{state.sort=e.target.value;render();});

render();
</script>
